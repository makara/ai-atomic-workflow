{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "channels": {},
    "interaction": {
      "type": "string",
      "enum": ["none", "enabled"]
    },
    "flow": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["main"]
          },
          "goal": {
            "type": "string"
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "not": {}
          }
        },
        "required": ["id", "type", "goal"],
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["main"]
          },
          "dependsOn": {
            "readOnly": true,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "agent": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skill": {
            "type": "string"
          },
          "channels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "task": {
            "type": "string"
          },
          "template": {
            "type": "string",
            "enum": ["startup", "router", "scope-entry", "adopting"]
          },
          "template_args": {
            "type": "object",
            "properties": {
              "paths": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "terminal": {
                "type": "string"
              },
              "questions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "prompt": {
                      "type": "string"
                    },
                    "condition": {
                      "type": "string"
                    }
                  },
                  "required": ["prompt", "condition"],
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "required": ["id", "type"],
        "additionalProperties": false
      }
    }
  },
  "required": ["name", "phases"],
  "additionalProperties": {}
}
