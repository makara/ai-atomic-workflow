{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "context": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "channels": {},
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["main", "approval", "gate", "flow"]
          },
          "goal": {
            "type": "string"
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "not": {}
          }
        },
        "required": ["id", "type", "goal"],
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["main", "approval", "gate", "flow"]
          },
          "dependsOn": {
            "readOnly": true,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "route": {
            "type": "string"
          },
          "agent": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skill": {
            "type": "string"
          },
          "channels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "task": {
            "type": "string"
          },
          "routing": {
            "type": "object",
            "properties": {
              "actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
                      "enum": ["continue", "retry", "jump", "end"]
                    },
                    "target": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  },
                  "required": ["action", "label", "description"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["actions"],
            "additionalProperties": false
          },
          "join": {
            "type": "string",
            "const": "any"
          },
          "jumps": {
            "readOnly": true,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "when": {
                  "type": "string",
                  "minLength": 1
                },
                "to": {
                  "type": "string"
                }
              },
              "required": ["when", "to"],
              "additionalProperties": false
            }
          },
          "use": {
            "type": "string"
          },
          "branches": {},
          "default": {},
          "mode": {},
          "when": {},
          "eval": {},
          "preText": {},
          "reads": {},
          "constraints": {},
          "runMode": {}
        },
        "required": ["id", "type"],
        "additionalProperties": false
      }
    }
  },
  "required": ["name", "phases"],
  "additionalProperties": {}
}
