{
  "name": "ai-atomic-workflow",
  "version": "0.4.0",
  "private": true,
  "description": "Graph-Engineering for Real Engineers: Graphs define workflows; workflows build graphs. Based on mattpocock/skills.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach --all run tsup",
    "check": "yarn manifests && yarn typecheck && yarn lint && yarn format:check",
    "check:ci": "yarn manifests && yarn typecheck && yarn lint && yarn format:check && yarn test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "manifests": "node scripts/gen-manifests.mjs --check",
    "publish:all": "yarn workspaces foreach --all --no-private npm publish --access public",
    "publish:dry": "yarn workspaces foreach --all --no-private npm publish --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "yarn workspaces foreach --all --no-private run typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prettier-plugin-compact-markdown-table": "0.1.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "yarn@4.17.1+sha512.ccbfabf7d7b6b32075088be9386fb9a2e00bb6887ef07fa56effabc890a56d53da1ccc4128d62db245fcbd3961b236d75335bdf7d5320ed6eafb7588b7ad4697"
}
